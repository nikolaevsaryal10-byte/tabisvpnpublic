# Tabis VPN Backend Environment Example Configuration
HOST=0.0.0.0
PORT=8080
DB_PATH=/root/tabis-backend/tabis.db
SERVERS_FILE=/root/tabis-backend/servers.txt

# Admin Panel Credentials
ADMIN_USER=admin
ADMIN_PASS=ChangeMeImmediately!

# AES Encryption Keys for Client Subscriptions (32 bytes key, 16 bytes IV)
AES_KEY=TabisVpnSafeKey_2026_Encrypted32
AES_IV=TabisVpnInitIV16

# SMTP Configuration (Email OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=Tabis VPN <support@tabisvpn.site>

# YooKassa Payment Gateway
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_API_URL=https://api.yookassa.ru/v3

# Proxy Nodes
HYSTERIA_SERVER=127.0.0.1
HYSTERIA_PORT=443
HYSTERIA_SNI=tabisvpn.site
REALITY_SERVER=127.0.0.1
REALITY_PORT=443
REALITY_PUBLIC_KEY=YOUR_REALITY_PUBLIC_KEY
REALITY_SHORT_ID=000000000000
REALITY_SNI=gateway.icloud.com
